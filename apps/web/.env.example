# Names only. Copy to .env.local and fill in; never commit real values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Private object storage (any S3-compatible store). Needed for uploads.
S3_BUCKET=
S3_REGION=us-east-1
# Leave S3_ENDPOINT empty for AWS S3; set it for R2 or a local mock.
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# true for a local mock or most non-AWS stores
S3_FORCE_PATH_STYLE=false
REDIS_URL=redis://localhost:6379
# Optional limits (defaults: 2 GiB, 3 hours)
MAX_UPLOAD_BYTES=
MAX_VIDEO_SECONDS=

# Worker only (apps/worker): a Postgres role that bypasses RLS. Never expose to the browser.
DATABASE_URL=

# Worker only. Unset = transcription jobs fail. "mock" = development placeholder text, refused when NODE_ENV=production.
TRANSCRIBE_PROVIDER=
